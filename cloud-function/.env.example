## secret must match ../frontend/tsconfig.json::plugins.schema.headers.x-hasura-admin-secret (for dev only)
HASURA_GRAPHQL_ADMIN_SECRET=changeForProduction
HASURA_GRAPHQL_URL=http://hasura:8080/v1/graphql
## secret must match ../backend/.env
CLOUD_FUNCTION_SECRET=someSecretInProduction
CLOUD_FUNCTION_URL=http://cloud-function:8090
NODE_ENV=development
LOG_REQUESTS=false
## image store — the fake-gcs service from docker-compose.yaml
GOOGLE_STORAGE_API_ENDPOINT=http://fake-gcs:4443
GOOGLE_STORAGE_PROJECT_ID=dev
GOOGLE_STORAGE_BUCKET_NAME=dev-bucket
# cat path/to/your/credentials.json | base64 | pbcopy
GOOGLE_APPLICATION_CREDENTIALS_BASE64=
# {jwt} will be dynamically replaced
PASSWORD_RESET_URL='http://localhost/#/reset-password?token={jwt}'
PASSWORD_RESET_SECRET=someSecretInProduction
## mail — the mailpit service from docker-compose.yaml, read it at localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=noreply@breedersdb.com
EMAIL_PASS='***'
EMAIL_FROM=noreply@breedersdb.com
EMAIL_REPLY_TO=admin@breedersdb.com
